{
  "custom": {
    "name": "",
    "zipName": "",
    "done": 0,
    "state": {
      "ok": false,
      "token": "",
      "id": "",
      "preview": "",
      "details": "",
      "findings": "",
      "verdict": "Pick a .zip, or drop one on the box."
    }
  },
  "params": {},
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {
      "grow": 0,
      "shrink": 0,
      "basis": "auto"
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "12px",
        "padding": "14px 18px 16px",
        "height": "100%",
        "backgroundColor": "var(--containerRoot)"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "tabs"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "props": {
          "direction": "row",
          "alignItems": "flex-end",
          "style": {
            "gap": "2px",
            "marginBottom": "6px",
            "borderBottomStyle": "solid",
            "borderBottomWidth": "1px",
            "borderBottomColor": "var(--border)"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "brand"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Toolbox Theme Manager  2.1.2",
              "style": {
                "fontSize": "13.5px",
                "fontWeight": 600,
                "whiteSpace": "nowrap",
                "color": "var(--label)",
                "padding": "9px 18px 8px 2px",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "2px",
                "borderBottomColor": "transparent"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "tab_home",
              "tabIndex": 0
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Installer",
              "style": {
                "fontSize": "13px",
                "padding": "9px 16px 8px",
                "cursor": "pointer",
                "whiteSpace": "nowrap",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "2px",
                "borderBottomColor": "transparent",
                "color": "var(--neutral-70)",
                "fontWeight": 600
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(page='/')"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onKeyDown": {
                  "config": {
                    "script": "\tif event.key in ('Enter', ' '):\n\t\tsystem.perspective.navigate(page='/')"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "tab_editor",
              "tabIndex": 0
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Customise",
              "style": {
                "fontSize": "13px",
                "padding": "9px 16px 8px",
                "cursor": "pointer",
                "whiteSpace": "nowrap",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "2px",
                "borderBottomColor": "transparent",
                "color": "var(--neutral-70)",
                "fontWeight": 600
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(page='/editor')"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onKeyDown": {
                  "config": {
                    "script": "\tif event.key in ('Enter', ' '):\n\t\tsystem.perspective.navigate(page='/editor')"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "tab_import"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            },
            "props": {
              "text": "Import",
              "style": {
                "fontSize": "13px",
                "padding": "9px 16px 8px",
                "cursor": "default",
                "whiteSpace": "nowrap",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "2px",
                "borderBottomColor": "var(--callToAction)",
                "color": "var(--label)",
                "fontWeight": 600
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "spacer"
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            },
            "props": {}
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "theme_switcher"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "230px"
            },
            "props": {
              "path": "ThemeDropdown",
              "params": {
                "refresh": 0
              },
              "style": {
                "minHeight": "34px",
                "marginBottom": "4px"
              }
            },
            "propConfig": {
              "props.params.refresh": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.done}"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "intro"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "props": {
          "text": "A zip holding one theme: its index.css and the .css files that imports. Checked before anything is written. Anything that fetches from elsewhere, runs code or leaves its own folder is refused; low contrast and other quality problems are listed for you to decide.",
          "style": {
            "fontSize": "12.5px",
            "color": "var(--neutral-70)",
            "lineHeight": "1.55",
            "maxWidth": "880px"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "top"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "14px"
          }
        },
        "children": [
          {
            "type": "ia.input.fileupload",
            "meta": {
              "name": "upload"
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            },
            "props": {
              "supportedFileTypes": [
                "zip"
              ],
              "fileSizeLimit": 2,
              "maxUploads": 1,
              "style": {
                "height": "166px"
              }
            },
            "events": {
              "component": {
                "onFileReceived": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tfrom java.lang import Throwable\n\timport themepack\n\ttry:\n\t\tdata = themepack.import_bytes(event.file.getBytes())\n\t\tself.view.custom.zipName = event.file.name\n\t\treport = themepack.stage_import(data, event.file.name, None)\n\t\tself.view.custom.state = themepack.import_view(report)\n\t\tself.view.custom.name = report.get('id') or ''\n\texcept (Exception, Throwable) as e:\n\t\tself.view.custom.state = themepack.import_view(None, str(e))\n"
                  }
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "name_col"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "220px"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "6px"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "name_l"
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "auto"
                },
                "props": {
                  "text": "Install as",
                  "style": {
                    "fontSize": "12px",
                    "color": "var(--neutral-70)"
                  }
                }
              },
              {
                "type": "ia.input.text-field",
                "meta": {
                  "name": "name"
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "32px"
                },
                "props": {
                  "placeholder": "theme id, e.g. ocean-dark",
                  "style": {
                    "height": "32px"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.name",
                        "bidirectional": true
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "name_row"
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "auto"
                },
                "props": {
                  "direction": "row",
                  "style": {
                    "gap": "8px"
                  }
                },
                "children": [
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "recheck_btn"
                    },
                    "position": {
                      "grow": 0,
                      "shrink": 0,
                      "basis": "auto"
                    },
                    "props": {
                      "text": "Check again",
                      "style": {
                        "height": "32px",
                        "whiteSpace": "nowrap",
                        "backgroundColor": "var(--containerBackground)",
                        "color": "var(--label)",
                        "borderStyle": "solid",
                        "borderWidth": "1px",
                        "borderColor": "var(--border)"
                      }
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tfrom java.lang import Throwable\n\timport themepack\n\ttry:\n\t\tif not self.view.custom.state.token:\n\t\t\treturn\n\t\treport = themepack.recheck_import(self.view.custom.state.token,\n\t\t\tself.view.custom.zipName, (self.view.custom.name or '').strip() or None)\n\t\tself.view.custom.state = themepack.import_view(report)\n\texcept (Exception, Throwable) as e:\n\t\tself.view.custom.state = themepack.import_view(None, str(e))\n"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "install_btn"
                    },
                    "position": {
                      "grow": 0,
                      "shrink": 0,
                      "basis": "auto"
                    },
                    "props": {
                      "text": "Install",
                      "style": {
                        "height": "32px",
                        "whiteSpace": "nowrap"
                      }
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tfrom java.lang import Throwable\n\timport themepack\n\ttry:\n\t\tthemepack.install_import(self.view.custom.state.token,\n\t\t\tself.view.custom.zipName, (self.view.custom.name or '').strip() or None)\n\t\ttheme = self.view.custom.state.id\n\t\tself.view.custom.state = {'ok': False, 'token': '', 'id': theme,\n\t\t\t'preview': self.view.custom.state.preview, 'details': '', 'findings': '',\n\t\t\t'verdict': \"Installed as '%s'. It is on the Installer tab and in every \"\n\t\t\t\t\"project's Theme menu.\" % theme}\n\t\tself.view.custom.name = ''\n\t\tself.view.custom.done += 1\n\texcept (Exception, Throwable) as e:\n\t\tself.view.custom.state = themepack.import_view(None, str(e))\n"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "propConfig": {
                      "props.enabled": {
                        "binding": {
                          "type": "property",
                          "config": {
                            "path": "view.custom.state.ok"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "verdict"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "14px",
            "color": "var(--label)",
            "fontWeight": 600
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.state.verdict"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "mid"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "gap": "12px"
          }
        },
        "children": [
          {
            "type": "ia.display.image",
            "meta": {
              "name": "preview"
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "170px"
            },
            "props": {
              "fit": {
                "mode": "fill"
              },
              "style": {
                "height": "51px",
                "borderRadius": "3px"
              }
            },
            "propConfig": {
              "props.source": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.state.preview"
                  }
                }
              },
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "len({view.custom.state.preview}) > 0"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "details"
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "12px",
                "color": "var(--neutral-70)",
                "lineHeight": "1.55",
                "maxWidth": "880px"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.state.details"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "findings"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "props": {
          "style": {
            "fontSize": "12px",
            "lineHeight": "1.5",
            "whiteSpace": "pre-wrap",
            "color": "var(--label)"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.state.findings"
              }
            }
          }
        }
      }
    ]
  }
}
